# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# Build output
/rr
dist/
bin/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# Debug files
debug
*.log

# Test coverage
coverage.out
coverage.html

plans/
reports/

# Claude Code local and runtime files
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Landing site (site/). rr's sync reads only this root .gitignore, so the site's
# dependencies and build output are listed here as well as in site/.gitignore.
site/node_modules/
site/.astro/
site/.wrangler/
site/fixtures/raw/
site/playwright-report/
site/test-results/
site/coverage/
.claude/worktrees/
