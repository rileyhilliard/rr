# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Dev server port. `stacks verify` and the Makefile read this.
PORT_WEB=4321
# Port the browser tests serve the production build on.
PORT_E2E=4322

# PostHog. Analytics is off while the key is empty (dev, tests, CI).
# Set both as Cloudflare Pages build variables for production.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=
