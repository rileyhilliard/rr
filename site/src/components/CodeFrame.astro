---
// A titled code frame for the landing page's config examples, which come from config.ts
// rather than Markdown, so codeBlocks never sees them. It mirrors codeBlocks' output
// (src/lib/markdown.ts): the figure, caption and copy-control data-* hooks, the copy button's
// labels and the site's Shiki themes, so global.css styles both frames with one set of rules
// and site.ts's enhanceCopyButtons wires both buttons. The button stays hidden until then;
// without JavaScript the code is plain selectable text.
import type { ComponentProps, HTMLAttributes } from "astro/types";
import { Code } from "astro:components";
import { shikiThemes } from "../lib/markdown";

type Props = Omit<HTMLAttributes<"figure">, "id"> &
  Pick<ComponentProps<typeof Code>, "code" | "lang"> & {
    title: string;
    /** The <pre>'s id, which the copy button names; unique on the page. */
    codeId: string;
  };
const { title, code, lang, codeId, ...rest } = Astro.props;
---

<figure data-code-block {...rest}>
  <figcaption data-code-title>{title}</figcaption>
  <Code id={codeId} code={code} lang={lang} themes={shikiThemes} defaultColor={false} />
  <span data-code-copy data-copy-root>
    <button type="button" hidden data-copy-command aria-label="Copy code" aria-controls={codeId}>
      <span data-copy-label>Copy</span>
    </button>
    <span data-copy-result role="status" aria-live="polite"></span>
  </span>
</figure>
